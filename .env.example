# TraceCart Environment Configuration Example
# Copy to .env for local overrides

# Server configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Data directories
DATA_DIR=data
RUNS_DIR=runs
CONFIGS_DIR=configs

# Vision pipeline mode: 'opencv' (classical contour + centroid) or 'yolo' (ultralytics)
VISION_BACKEND=opencv
